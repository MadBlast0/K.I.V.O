{
  "manifest_version": 3,
  "name": "KIVO",
  "short_name": "KIVO",
  "version": "0.1.0",
  "description": "Lets KIVO, your voice assistant on this PC, read and act on the page you're on when you ask it to.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "tabs", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "128": "icon128.png"
  }
}
